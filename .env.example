# ---- Public details shown on the site (leave blank until supplied) ----
# Digits only with country code, e.g. 919876543210 (no +, spaces or dashes).
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_SITE_URL=https://www.manmanthan.co.in

# ---- Enquiry form: send each enquiry to the counsellor's inbox via EmailJS ----
# Server-only. Set these in Vercel: Project > Settings > Environment Variables (then redeploy).
# Never prefix with NEXT_PUBLIC_.
EMAILJS_SERVICE_ID=       # EmailJS > Email Services > your Gmail service (looks like service_xxxxxxx)
EMAILJS_TEMPLATE_ID=      # EmailJS > Email Templates > your template (looks like template_xxxxxxx)
EMAILJS_PUBLIC_KEY=       # EmailJS > Account > General / API keys > Public Key
EMAILJS_PRIVATE_KEY=      # Optional but recommended: Account > API keys > Private Key
# Alternative if you do not use EmailJS: a webhook that receives the enquiry as JSON.
ENQUIRY_WEBHOOK_URL=
