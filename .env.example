# Public contact details (shown on the site). Leave blank until supplied.
# Digits only with country code, e.g. 919876543210 (no +, spaces or dashes).
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only: URL that receives enquiry submissions as JSON (e.g. a Make/Zapier/Formspree-style webhook
# or your own service). Never prefix with NEXT_PUBLIC_. If unset, the form will NOT report success.
ENQUIRY_WEBHOOK_URL=
